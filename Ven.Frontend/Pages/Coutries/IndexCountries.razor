@page "/countries"

<h3>Paises</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/countries/create">Nuevo País</a>
</div>

<GenericList MyList="Countries">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>País</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Countries!)
                {
                    <tr>
                        <td>
                            @item.Name
                        </td>
                        <td>
                            <a href="/Countries/edit/@item.CountryId" class="btn btn-warning">Editar</a>
                            <button class="btn btn-danger" @onclick="@(()=> Delete(item))">Borrar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

<Pagination CurrentPage="CurrentPage"
            SelectedPage="SelectedPage"
            TotalPages="TotalPages">
</Pagination>


